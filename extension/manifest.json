{
  "manifest_version": 3,
  "name": "导出xmol入库单 · 南大试剂",
  "version": "1.2.6",
  "description": "在南京大学试剂系统查看采购明细、核对到货、按 X-MOL 模板导出所选商品并记录订单导出次数。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reagent.nju.edu.cn/*"
      ],
      "js": [
        "core.js",
        "detail.js",
        "xls-template.js",
        "xls-export.js",
        "panel.js",
        "entry.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
